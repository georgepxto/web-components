{
  "name": "@georgepxto/step-timeline",
  "version": "0.1.0",
  "description": "A dependency-free <step-timeline> web component: process steps that fill in sequence when they come into view, or pin to the screen and advance as the page scrolls.",
  "type": "module",
  "license": "MIT",
  "author": "georgepxto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georgepxto/web-components.git",
    "directory": "step-timeline"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "timeline",
    "steps",
    "process",
    "scrollytelling"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/step-timeline.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
