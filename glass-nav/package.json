{
  "name": "@georgepxto/glass-nav",
  "version": "0.1.0",
  "description": "A dependency-free <glass-nav> web component: a floating frosted-glass navigation bar that highlights the section in view and scrolls to it with an offset.",
  "type": "module",
  "license": "MIT",
  "author": "georgepxto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georgepxto/web-components.git",
    "directory": "glass-nav"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "navigation",
    "navbar",
    "glassmorphism",
    "scrollspy"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/glass-nav.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
